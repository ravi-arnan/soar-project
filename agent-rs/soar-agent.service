[Unit]
Description=SOAR Agen Ringan Rust (alternatif Wazuh Agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/soar-agent
ExecStart=/usr/local/bin/soar-agent --webhook http://${SERVER}:5678/webhook/wazuh-alert --agent-id ${AGENT_ID} --agent-name ${AGENT_NAME} --fleet-url http://${SERVER}:8080/api/heartbeat $WATCH_ARGS
Restart=always
RestartSec=5
# ponytail: tanpa Docker, footprint 2-5 MB, cocok untuk 100 workstation
Environment=RUST_LOG=info
# quarantine butuh akses /var/ossec/quarantine, buat dulu: sudo mkdir -p /var/ossec/quarantine && sudo chown $USER /var/ossec/quarantine

[Install]
WantedBy=multi-user.target
