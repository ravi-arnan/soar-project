#!/bin/bash
# block-domain - Wazuh custom Active Response (SOAR phishing)
#
# Sinkhole domain phishing ke /etc/hosts (0.0.0.0) di endpoint, sehingga host
# tidak bisa membuka situs phishing. Menerima perintah JSON di stdin (protokol AR v1).
#
# Body API yang diharapkan: command "!block-domain", arguments ["<url_atau_domain>"]

set -uo pipefail

LOG="${SOAR_AR_LOG:-/var/ossec/logs/active-responses.log}"
HOSTS="${SOAR_HOSTS_FILE:-/etc/hosts}"
MARK="# WAZUH-SOAR-SINKHOLE"
BACKUP_DIR="${SOAR_BACKUP_DIR:-/var/ossec/quarantine/.hosts-backup}"
MAX_BACKUPS=20
PYTHON_BIN="${SOAR_PYTHON_BIN:-/var/ossec/framework/python/bin/python3}"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3 || true)"
fi

ts() { date '+%Y/%m/%d %H:%M:%S'; }
log_msg() {
  mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
  printf '%s block-domain: %s\n' "$(ts)" "$1" >> "$LOG"
}

INPUT="$(cat)"

if [ -z "$PYTHON_BIN" ]; then
  log_msg "ERROR python3 tidak tersedia untuk parse payload JSON AR"
  exit 1
fi

PARSED="$("$PYTHON_BIN" - "$INPUT" <<'PY'
import json, sys, urllib.parse
try:
    obj = json.loads(sys.argv[1] or "{}")
except Exception:
    sys.exit(2)
cmd = str(obj.get("command") or "")
params = obj.get("parameters") if isinstance(obj.get("parameters"), dict) else {}
extra = params.get("extra_args") if isinstance(params.get("extra_args"), list) else []
raw = str(extra[0]).strip() if extra else ""
if "://" in raw:
    host = urllib.parse.urlparse(raw).hostname or ""
else:
    host = raw.split("/")[0].split("?")[0].split("#")[0].split("@")[-1].split(":")[0]
dom = host.strip().lower().rstrip(".")
print(cmd)
print(raw)
print(dom)
PY
)" || {
  log_msg "ERROR payload JSON AR tidak valid"
  exit 1
}

COMMAND="$(printf '%s\n' "$PARSED" | sed -n '1p')"
RAW="$(printf '%s\n' "$PARSED" | sed -n '2p')"
DOM="$(printf '%s\n' "$PARSED" | sed -n '3p')"

# Validasi domain ketat (hindari IP, karakter aneh, atau label kosong)
if ! printf '%s' "$DOM" | grep -qE '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*\.[a-z]{2,}$'; then
  log_msg "ERROR domain tidak valid (raw='$RAW' dom='$DOM')"
  exit 1
fi

# Denylist domain infrastruktur/kritis agar tidak menyebabkan self-DoS
is_protected_domain() {
  local d="$1"
  local base_list="localhost localdomain local internal lan wazuh.com tailscale.com cloudflare.com github.com googleapis.com google.com virustotal.com abuse.ch telegram.org ubuntu.com debian.org nixos.org microsoft.com windowsupdate.com apple.com"
  local extra_list="${SOAR_PROTECTED_DOMAINS:-}"
  local p
  for p in $base_list ${extra_list//,/ }; do
    p="$(printf '%s' "$p" | tr '[:upper:]' '[:lower:]')"
    [ -z "$p" ] && continue
    if [ "$d" = "$p" ] || [[ "$d" == *".$p" ]]; then
      return 0
    fi
  done
  return 1
}

if is_protected_domain "$DOM"; then
  log_msg "DITOLAK domain kritis dilindungi: $DOM"
  exit 1
fi

mkdir -p "$BACKUP_DIR" 2>/dev/null || true
if [ -f "$HOSTS" ]; then
  cp -f "$HOSTS" "$BACKUP_DIR/hosts.$(date +%s).$$.bak" 2>/dev/null || true
  # Batasi jumlah backup agar disk tidak penuh
  ls -1t "$BACKUP_DIR"/hosts.*.bak 2>/dev/null | tail -n +$((MAX_BACKUPS + 1)) | xargs -r rm -f
fi

case "$COMMAND" in
  add)
    ALREADY="$(awk -v d="$DOM" -v m="$MARK" '
      index($0, m) > 0 && $1 == "0.0.0.0" && ($2 == d || $2 == "www." d) { found=1; exit }
      END { print found ? "1" : "0" }
    ' "$HOSTS" 2>/dev/null || echo 0)"
    if [ "$ALREADY" = "1" ]; then
      log_msg "$DOM sudah disinkhole, skip"
    else
      {
        printf '0.0.0.0 %s %s\n' "$DOM" "$MARK"
        printf '0.0.0.0 www.%s %s\n' "$DOM" "$MARK"
      } >> "$HOSTS"
      log_msg "SINKHOLED $DOM -> 0.0.0.0 ($HOSTS)"
    fi
    ;;
  delete)
    if [ -f "$HOSTS" ]; then
      TMP="$(mktemp)"
      awk -v d="$DOM" -v m="$MARK" '
        {
          if (index($0, m) > 0 && $1 == "0.0.0.0" && ($2 == d || $2 == "www." d)) {
            next
          }
          print $0
        }' "$HOSTS" > "$TMP" && cat "$TMP" > "$HOSTS" && rm -f "$TMP"
      log_msg "ROLLBACK sinkhole $DOM"
    fi
    ;;
  *)
    log_msg "command tidak dikenal '$COMMAND'"
    exit 1
    ;;
esac

exit 0
