#!/bin/bash
# quarantine-file - Wazuh custom Active Response (SOAR B1)
#
# Memindahkan file malware yang di-flag ke folder karantina di agent,
# serta mendukung rollback aman (`delete`) berbasis manifest.
# Menerima perintah JSON di stdin (protokol AR v1).
#
# Body API yang diharapkan: command "!quarantine-file", arguments ["<path_file>"]
# -> Wazuh meneruskan path itu sebagai parameters.extra_args[0].

set -uo pipefail

LOG="${SOAR_AR_LOG:-/var/ossec/logs/active-responses.log}"
QUARANTINE_DIR="${SOAR_QUARANTINE_DIR:-/var/ossec/quarantine}"
MANIFEST="$QUARANTINE_DIR/manifest.json"
PYTHON_BIN="${SOAR_PYTHON_BIN:-/var/ossec/framework/python/bin/python3}"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3 || true)"
fi

ts() { date '+%Y/%m/%d %H:%M:%S'; }
log_msg() {
  mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
  printf '%s quarantine-file: %s\n' "$(ts)" "$1" >> "$LOG"
}

INPUT="$(cat)"

if [ -z "$PYTHON_BIN" ]; then
  log_msg "ERROR python3 tidak tersedia untuk parse payload JSON AR"
  exit 1
fi

PARSED="$("$PYTHON_BIN" - "$INPUT" <<'PY'
import json, sys
try:
    obj = json.loads(sys.argv[1] or "{}")
except Exception:
    sys.exit(2)
cmd = str(obj.get("command") or "")
params = obj.get("parameters") if isinstance(obj.get("parameters"), dict) else {}
extra = params.get("extra_args") if isinstance(params.get("extra_args"), list) else []
target = str(extra[0]) if extra else ""
if "\n" in cmd or "\n" in target or "\x00" in target:
    sys.exit(3)
print(cmd)
print(target)
PY
)" || {
  log_msg "ERROR payload JSON AR tidak valid"
  exit 1
}

COMMAND="$(printf '%s\n' "$PARSED" | sed -n '1p')"
FILE="$(printf '%s\n' "$PARSED" | sed -n '2p')"

if [ -z "$FILE" ]; then
  log_msg "ERROR tidak ada path di extra_args"
  exit 1
fi

# Tolak path relatif atau traversal yang menyentuh symlink
if [[ "$FILE" != /* ]]; then
  log_msg "DITOLAK path non-absolut $FILE"
  exit 1
fi

if [ -L "$FILE" ]; then
  log_msg "DITOLAK target adalah symlink $FILE"
  exit 1
fi

REAL_FILE="$(realpath -m -- "$FILE" 2>/dev/null || true)"
if [ -z "$REAL_FILE" ]; then
  log_msg "ERROR gagal canonicalize path $FILE"
  exit 1
fi

# Pengaman direktori sistem (defense-in-depth, dijalankan SETELAH realpath)
is_protected_path() {
  case "$1" in
    /|/etc|/etc/*|/boot|/boot/*|/sys|/sys/*|/proc|/proc/*|/dev|/dev/*|/usr|/usr/*|/lib|/lib/*|/lib64|/lib64/*|/bin|/bin/*|/sbin|/sbin/*|/root/.ssh|/root/.ssh/*|/var/ossec|/var/ossec/*)
      return 0
      ;;
  esac
  return 1
}

if is_protected_path "$REAL_FILE"; then
  log_msg "DITOLAK path sistem terlarang $REAL_FILE (input=$FILE)"
  exit 1
fi

mkdir -p "$QUARANTINE_DIR"
chmod 700 "$QUARANTINE_DIR"

case "$COMMAND" in
  add)
    if [ -L "$REAL_FILE" ]; then
      log_msg "DITOLAK target symlink $REAL_FILE"
      exit 1
    fi
    if [ -f "$REAL_FILE" ]; then
      SAFE_BASE="$(basename -- "$REAL_FILE" | tr -cd 'A-Za-z0-9._-')"
      [ -z "$SAFE_BASE" ] && SAFE_BASE="file"
      STAMP="$(date +%s%N).$$"
      DEST="$QUARANTINE_DIR/${SAFE_BASE}.${STAMP}.quarantined"
      if mv -n -- "$REAL_FILE" "$DEST"; then
        chmod 000 "$DEST"
        "$PYTHON_BIN" - "$MANIFEST" "$REAL_FILE" "$DEST" <<'PY'
import json, os, sys, tempfile, time
mpath, orig, dest = sys.argv[1], sys.argv[2], sys.argv[3]
records = []
if os.path.isfile(mpath):
    try:
        with open(mpath, "r", encoding="utf-8") as fh:
            data = json.load(fh)
            if isinstance(data, list):
                records = data
    except Exception:
        records = []
records = [r for r in records if r.get("original") != orig]
records.append({"original": orig, "quarantined": dest, "timestamp": int(time.time())})
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(mpath), prefix=".manifest.")
with os.fdopen(fd, "w", encoding="utf-8") as fh:
    json.dump(records, fh, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, mpath)
PY
        log_msg "QUARANTINED $REAL_FILE -> $DEST"
      else
        log_msg "GAGAL memindahkan $REAL_FILE"
        exit 1
      fi
    else
      log_msg "file tidak ditemukan atau bukan file reguler: $REAL_FILE"
    fi
    ;;
  delete)
    RESTORED="$("$PYTHON_BIN" - "$MANIFEST" "$QUARANTINE_DIR" "$REAL_FILE" <<'PY'
import json, os, shutil, sys, tempfile
mpath, qdir, target = sys.argv[1], os.path.realpath(sys.argv[2]), sys.argv[3]
if not os.path.isfile(mpath):
    sys.exit(2)
with open(mpath, "r", encoding="utf-8") as fh:
    records = json.load(fh)
if not isinstance(records, list):
    sys.exit(2)
match_idx = None
for i, rec in enumerate(records):
    if rec.get("original") == target or rec.get("quarantined") == target:
        match_idx = i
        break
if match_idx is None:
    sys.exit(3)
rec = records[match_idx]
qpath = str(rec.get("quarantined") or "")
orig = str(rec.get("original") or "")
if not qpath or not orig or os.path.islink(qpath) or not os.path.isfile(qpath):
    sys.exit(4)
real_q = os.path.realpath(qpath)
if not (real_q == qdir or real_q.startswith(qdir + os.sep)):
    sys.exit(5)
if os.path.lexists(orig):
    sys.exit(6)
os.chmod(real_q, 0o644)
os.makedirs(os.path.dirname(orig), exist_ok=True)
shutil.move(real_q, orig)
records.pop(match_idx)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(mpath), prefix=".manifest.")
with os.fdopen(fd, "w", encoding="utf-8") as fh:
    json.dump(records, fh, indent=2)
os.chmod(tmp, 0o600)
os.replace(tmp, mpath)
print(f"{qpath} -> {orig}")
PY
    )"
    RC=$?
    if [ "$RC" -eq 0 ]; then
      log_msg "RESTORED $RESTORED"
    else
      log_msg "GAGAL rollback untuk $REAL_FILE (code=$RC)"
      exit 1
    fi
    ;;
  *)
    log_msg "command tidak dikenal '$COMMAND'"
    exit 1
    ;;
esac

exit 0
