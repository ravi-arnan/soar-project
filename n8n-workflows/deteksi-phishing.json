      {
        "id": "c3fd75f9-d2c1-475a-b270-19cde16838b6",
        "name": "Rangkum Phishing",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1792,
          304
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const alert = $('Ekstrak Alert Phishing').first().json;\nconst cacheNode = $('Cek Cache URL').first().json;\n\nlet gsb_status, gsb_threat = false, gsb_type = '';\nlet us_ready = false, us_malicious = false, us_score = 0;\n\nif (cacheNode._cacheHit) {\n  const c = cacheNode._cachedStats || {};\n  gsb_status = c.gsb_status || 'cache'; gsb_threat = !!c.gsb_threat; gsb_type = c.gsb_type || '';\n  us_ready = !!c.us_ready; us_malicious = !!c.us_malicious; us_score = c.us_score || 0;\n} else {\n  // ----- Google Safe Browsing -----\n  const g = $('GSB Lookup').first().json;\n  const gcode = g.statusCode;\n  const gbody = (g.body !== undefined) ? g.body : g;\n  if (gcode === 200 || (gbody && gbody.matches !== undefined && gcode === undefined)) {\n    const matches = gbody && gbody.matches;\n    if (Array.isArray(matches) && matches.length > 0) { gsb_threat = true; gsb_type = matches[0].threatType || 'THREAT'; gsb_status = 'threat'; }\n    else { gsb_status = 'clean'; }\n  } else {\n    gsb_status = 'unavailable';   // key belum diset / error -> fallback ke URLScan\n  }\n  // ----- URLScan result -----\n  let u = {};\n  try { u = $('URLScan Result').first().json || {}; } catch (e) { u = {}; }\n  const ucode = u.statusCode;\n  const ubody = (u.body !== undefined) ? u.body : u;\n  const ov = ubody && ubody.verdicts && ubody.verdicts.overall;\n  if (ucode === 200 && ov) {\n    us_ready = true;\n    us_malicious = !!ov.malicious;\n    us_score = Number(ov.score || 0);\n  }   // 404/202 -> belum siap -> us_ready=false\n  // cache\n  if (alert.url && (gsb_status !== 'unavailable' || us_ready)) {\n    const sd = $getWorkflowStaticData('global');\n    sd.urlCache = sd.urlCache || {};\n    sd.urlCache[alert.url] = { stats: { gsb_status, gsb_threat, gsb_type, us_ready, us_malicious, us_score }, ts: Date.now() };\n    const keys = Object.keys(sd.urlCache);\n    if (keys.length > 1000) { keys.sort((a,b)=>(sd.urlCache[a].ts||0)-(sd.urlCache[b].ts||0)); keys.slice(0,250).forEach(k=>delete sd.urlCache[k]); }\n  }\n}\n\nconst forceReview = /demoreview/i.test(alert.url || '');\nconst sources_ok = (gsb_status !== 'unavailable') || us_ready;   // minimal satu sumber memberi jawaban\n\nlet verdict;\nif (!sources_ok)                          verdict = 'unverified';   // semua sumber gagal -> jangan klaim aman\nelse if (gsb_threat || us_malicious)      verdict = 'malicious';\nelse if (us_ready && us_score >= 40)      verdict = 'suspicious';\nelse if (gsb_status === 'clean' || (us_ready && !us_malicious)) verdict = 'aman';\nelse                                      verdict = 'unverified';\nif (forceReview && verdict !== 'malicious') verdict = 'suspicious';\n\nconst is_threat    = (verdict !== 'aman');\nconst auto_block   = (verdict === 'malicious');\nconst need_confirm = (verdict === 'suspicious' || verdict === 'unverified');\n\nlet severity, severityIcon, severityLabel;\nif (verdict === 'malicious')      { severity='HIGH';       severityIcon='🚨'; severityLabel='BERBAHAYA'; }\nelse if (verdict === 'suspicious'){ severity='MEDIUM';     severityIcon='⚠️'; severityLabel='MENCURIGAKAN'; }\nelse if (verdict === 'unverified'){ severity='UNVERIFIED'; severityIcon='🛑'; severityLabel='PERLU VERIFIKASI'; }\nelse                              { severity='SAFE';       severityIcon='✅'; severityLabel='AMAN'; }\n\n// teks ringkas sumber (dipakai pesan + prompt AI)\nconst GSB_LABEL = {SOCIAL_ENGINEERING:'Phishing', MALWARE:'Malware', UNWANTED_SOFTWARE:'Unwanted software', POTENTIALLY_HARMFUL_APPLICATION:'Aplikasi berbahaya'};\nconst gsb_text = gsb_status === 'threat' ? ('TERDAFTAR - ' + (GSB_LABEL[gsb_type] || gsb_type.replace(/_/g,' ')))\n               : gsb_status === 'clean' ? 'bersih'\n               : 'tidak tersedia';\nconst us_text = us_ready ? ('skor ' + us_score + (us_malicious ? ' (malicious)' : '')) : 'belum siap';\n\n// ===== F: explainability + self-aware (phishing) =====\nlet decision_reason;\nif (gsb_threat) decision_reason = 'Google Safe Browsing menandai URL sebagai ancaman -> auto-block (sinkhole domain)';\nelse if (us_malicious) decision_reason = 'URLScan.io verdict malicious -> auto-block (sinkhole domain)';\nelse if (verdict === 'unverified') decision_reason = 'Sumber reputasi gagal/unverified -> tidak dianggap aman, keputusan analis';\nelse if (need_confirm) decision_reason = 'URLScan skor ' + (us_score || 0) + ' (mencurigakan) -> keputusan analis (tombol)';\nelse if (auto_block) decision_reason = 'Terdeteksi berbahaya -> auto-block (sinkhole domain)';\nelse decision_reason = 'URL dinilai aman oleh GSB/URLScan';\nconst degraded = (verdict === 'unverified');\nconst degraded_reason = degraded ? 'Deteksi TERDEGRADASI: sumber reputasi (GSB/URLScan) tidak dapat memverifikasi - keyakinan berkurang' : '';\n\nreturn [{ json: {\n  url: alert.url, srcip: alert.srcip, agent_id: alert.agent_id, agent_name: alert.agent_name,\n  rule_level: alert.rule_level, timestamp: alert.timestamp,\n  gsb_status, gsb_threat, gsb_type, us_ready, us_malicious, us_score,\n  gsb_text, us_text,\n  verdict, is_threat, auto_block, need_confirm,\n  severity, severityIcon, severityLabel, decision_reason, degraded, degraded_reason\n} }];"
        }
      },
