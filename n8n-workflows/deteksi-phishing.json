      {
        "id": "55d0ccca-c555-41cd-b360-5559828ba279",
        "name": "Gemini Generate",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2880,
          304
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const apiKey = $env.GEMINI_API_KEY;\nif (!apiKey) throw new Error('GEMINI_API_KEY belum di-set');\nconst prompt = $json.prompt;\nconst body = { contents: [{ parts: [{ text: prompt }] }], generationConfig: { thinkingConfig: { thinkingBudget: 0 }, temperature: 0.3, maxOutputTokens: 800 } };\nconst resp = await this.helpers.httpRequest({ method: 'POST', url: `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body), timeout: 30000 });\nlet text = resp?.candidates?.[0]?.content?.parts?.[0]?.text || JSON.stringify(resp);\nlet clean = text.replace(/<think>[\\s\\S]*?<\\/think>/g, '').replace(/[*_`\\[\\]()]/g, '').replace(/\\n\\n+/g, '\\n').trim();\nreturn [{ json: { ...$json, response: clean, gemini_response: clean } }];"
        }
      },
