      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const alert = $input.first().json;\nconst url = alert.url;\n\n// Cache verdict VirusTotal per-URL (persist staticData). Hit & segar -> lewati\n// submit+wait+report+urlscan (hemat 2+ panggilan VT per event).\nconst sd = $getWorkflowStaticData('global');\nsd.urlCache = sd.urlCache || {};\nconst TTL = 6 * 60 * 60 * 1000;   // 6 jam\n\nlet _cacheHit = false, _cachedStats = null;\nif (url && sd.urlCache[url] && (Date.now() - (sd.urlCache[url].ts || 0)) < TTL) {\n  _cacheHit = true;\n  _cachedStats = sd.urlCache[url].stats || {};\n}\nreturn [{ json: { ...alert, _cacheHit, _cachedStats } }];"
