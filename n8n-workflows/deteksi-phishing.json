      {
        "id": "5388d3c2-5e81-4898-964c-e08f7aa00cf5",
        "name": "Build Payload",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2672,
          304
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const r = $('Rangkum Phishing').first().json;\nconst prompt =\n  'Anda adalah analis keamanan siber. Respon HANYA dalam Bahasa Indonesia formal, 2-3 kalimat, tanpa karakter markdown (asterisk underscore backtick bracket).\\n\\n' +\n  'URL dicurigai: ' + r.url + '\\n' +\n  'IP sumber: ' + r.srcip + '\\n' +\n  'Status: ' + r.severityLabel + '\\n' +\n  'Google Safe Browsing: ' + r.gsb_text + '\\n' +\n  'URLScan.io: ' + r.us_text + '\\n\\n' +\n  'Jelaskan tingkat bahaya URL ini dan rekomendasi tindakan yang harus diambil.';\nreturn [{ json: { prompt } }];"
        }
