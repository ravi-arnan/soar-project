# SOAR secrets & config - SALIN ke `.env` lalu isi. `.env` di-gitignore.
# Jangan pernah commit kredensial live ke git.

# --- Public URLs & Network Binding ---
PUBLIC_SOAR_URL=https://soar.example.com
PUBLIC_ENROLL_URL=https://soar-agent.example.com
WAZUH_MANAGER_HOST=192.0.2.10
N8N_HOST=localhost
N8N_BIND_ADDR=127.0.0.1
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Makassar
# Bind service internal ke loopback (ubah ke 0.0.0.0 hanya jika endpoint perlu akses LAN/VPN langsung)
FLEET_BIND=0.0.0.0
MISP_BIND=127.0.0.1
ALERT_LOG_BIND=127.0.0.1

# --- Telegram (notifikasi + human-in-the-loop) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Chat tujuan alert kesehatan (health-monitor). Ambil via @get_id_bot.
TELEGRAM_CHAT_ID=123456789
# Daftar chat ID / user ID Telegram yang diizinkan menekan tombol HITL (dipisah koma)
TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_ALLOWED_USER_IDS=

# --- Shared Secret Webhook n8n (verifikasi custom-n8n, soar-agent, tg-callback-poller) ---
# Generate: openssl rand -hex 32
N8N_WEBHOOK_SECRET=replace-with-random-n8n-webhook-secret-min-32-chars

# --- Threat Intel (phishing & malware ensemble) ---
GSB_API_KEY=your-google-safebrowsing-key
URLSCAN_API_KEY=your-urlscan-key
MALWAREBAZAAR_API_KEY=your-malwarebazaar-auth-key
OTX_API_KEY=your-otx-api-key

# --- Wazuh API & Indexer ---
# Wajib ganti password default Wazuh sebelum produksi.
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=change-me
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=change-me

# --- LLM AI (analisis kontekstual: ringkasan + rekomendasi) ---
GEMINI_API_KEY=your-gemini-api-key
EXPERIENTIAL_API_KEY=xpl_your-experiential-api-key
POLLINATIONS_API_KEY=your-pollinations-api-key
HCNSEC_API_KEY=your-hcnsec-api-key

# --- Health Monitor & Watch-the-Watcher ---
N8N_HEALTH_URL=http://127.0.0.1:5678/healthz
HEALTH_INTERVAL=60
# Opsional: URL external dead-man's switch (mis. Healthchecks.io / Uptime Kuma push)
HEALTHCHECK_PING_URL=

# --- Hardened Deploy (deploy/hardened) ---
# Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-24
# Hash bcrypt dari `caddy hash-password` (tanpa tanda kutip)
CADDY_BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH_HASH=$2a$14$replace-with-caddy-hash-password-output
N8N_HOSTNAME=soar.local

# --- Fleet Control Plane & Auth Tokens ---
# Generate masing-masing dengan `openssl rand -hex 32` (minimal 32 karakter)
FLEET_COMMAND_TOKEN=your-fleet-command-token-min-32-chars
FLEET_AGENT_POLL_TOKENS_JSON={"003":"your-agent-003-token-min-32-chars","009":"your-agent-009-token-min-32-chars"}
DASHBOARD_LOGIN_TOKEN=your-dashboard-login-token-min-32-chars
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://soar.example.com
# Kunci enkripsi at-rest untuk API key AI/TI di SQLite system_settings
SOAR_SETTINGS_ENCRYPTION_KEY=your-settings-encryption-key-min-32-chars
# Akun admin awal (hanya dipakai saat tabel users masih kosong)
FLEET_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FLEET_BOOTSTRAP_ADMIN_PASSWORD=

# --- Cloudflare Zero Trust Access (Verifikasi JWT & Auto-Sync Policy) ---
# Wajib diisi jika menggunakan Cloudflare Access SSO:
# CF_ACCESS_TEAM_DOMAIN contoh: your-team.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Opsional: sinkronisasi otomatis daftar user aktif ke Access Policy
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_APP_ID=
CLOUDFLARE_ACCESS_POLICY_ID=

# --- 2FA Step-Up Verification (Email Resend & Telegram) ---
RESEND_API_KEY=re_your-resend-api-key-here
ADMIN_EMAIL=admin@example.com

# --- Riwayat Event SQLite ---
FLEET_EVENTS_DB=/state/events.db
FLEET_EVENTS_RETENTION_DAYS=90
FLEET_EVENTS_MAX_ROWS=200000

# --- MISP & Alert Log / HITL Registry ---
MISP_API_TOKEN=
ALERT_DECISION_FILE=/state/decisions.json
ALERT_DECISION_AUDIT_FILE=/state/decisions-audit.jsonl
ALERT_DECISION_TTL_SECS=21600
# Wajib diisi (fail-closed di produksi) - generate dengan `openssl rand -hex 32`
ALERT_LOG_TOKEN=your-decision-registry-token-min-32-chars
