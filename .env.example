# SOAR secrets & config — SALIN ke `.env` lalu isi. `.env` di-gitignore.
# Kategori D (manajemen secret): tak ada kredensial hardcode di source/compose.

# --- Telegram (notifikasi + human-in-the-loop) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Chat tujuan alert kesehatan (health-monitor). Ambil via @get_id_bot.
TELEGRAM_CHAT_ID=123456789

# --- Threat intel (dipakai workflow phishing) ---
GSB_API_KEY=your-google-safebrowsing-key
URLSCAN_API_KEY=your-urlscan-key

# --- Wazuh API (dipakai health-monitor & callback handler) ---
# Ganti password default Wazuh sebelum produksi (jangan pakai MyS3cr37P450r.*-).
WAZUH_API_URL=https://host.docker.internal:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASS=change-me

# --- LLM AI (Gemini API, full — hemat 4GB vs Ollama lokal) ---
# Dulu Ollama llama3.2:3b lokal (4GB RAM). Sekarang Gemini 2.0 Flash API untuk 100 PC ringan.
# Isi dari https://aistudio.google.com/app/apikey — gratis 60 req/menit. Tanpa ini workflow akan error.
GEMINI_API_KEY=your-gemini-api-key
# Alternatif: pakai 9router proxy (OpenAI-compatible) kalau mau free combo: https://github.com/...)
# GEMINI_API_KEY tetap dipakai sebagai $env.GEMINI_API_KEY di n8n (jsCode Gemini Generate).

# --- Health monitor (kategori F) ---
N8N_HEALTH_URL=http://n8n:5678/healthz
HEALTH_INTERVAL=60
# OLLAMA_URL deprecated (sudah full Gemini). Biarkan kosong atau hapus jika tidak pakai Ollama lokal.
# OLLAMA_URL=http://host.docker.internal:11434/api/version

# --- Hardened deploy (deploy/hardened, kategori D) ---
# Kunci enkripsi n8n (credential store). Generate: openssl rand -hex 24
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-24
# Basic-auth Caddy di depan editor n8n. Hash: `caddy hash-password`.
# Hash bcrypt memuat '$' — tempel apa adanya (dibaca via env_file, tidak
# di-interpolasi compose). Jangan bungkus tanda kutip.
CADDY_BASIC_AUTH_USER=admin
CADDY_BASIC_AUTH_HASH=$2a$14$replace-with-caddy-hash-password-output
# Hostname untuk sertifikat TLS n8n (Caddy internal CA kalau bukan domain publik)
N8N_HOSTNAME=soar.local
